# ============================================================
# Prime Cargo PWA - Variáveis de Ambiente
# Copie para .env.local e preencha com os valores reais.
# NUNCA faça commit de .env.local com credenciais!
# ============================================================

# --- NextAuth ---
NEXTAUTH_URL=https://seu-dominio.vercel.app
NEXTAUTH_SECRET= # Gere com: openssl rand -base64 32

# --- Azure AD (Login Microsoft) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Google OAuth (Login Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Graph (Acesso backend ao SharePoint) ---
# Se diferente do Azure AD acima, configure separadamente.
# Caso contrário, o app usará os mesmos valores do Azure AD.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# --- SharePoint ---
# Site ID do SharePoint onde estão as listas e biblioteca
SHAREPOINT_SITE_ID=
# ID do Drive (Biblioteca de Documentos) para upload de arquivos
SHAREPOINT_DRIVE_ID=
# Caminho base na biblioteca (sem barra no início)
SHAREPOINT_BASE_PATH=PrimeCargo/Vistorias

# --- IA (Análise de pesquisa) ---
# Provedor: gemini, openai ou azure-openai
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
GEMINI_API_KEY=
AUTH_TRUST_HOST=true

# --- E-mail Corporativo ---
# Método: graph (Microsoft Graph) ou smtp
EMAIL_SERVICE=graph
EMAIL_FROM=noreply@primecargo.com.br
# Para SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=true

# --- Vídeo ao Vivo (STUN/TURN) ---
# Serviço TURN necessário para WebRTC em produção
# Opções: Twilio, Cloudflare Calls, Metered, self-hosted
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# URL STUN pública (gratuita, sem credenciais)
STUN_SERVER_URL=stun:stun.l.google.com:19302

# --- Aplicação ---
APP_URL=https://seu-dominio.vercel.app
APP_TIMEZONE=America/Sao_Paulo
